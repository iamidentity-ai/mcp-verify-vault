# Copy to .env (gitignored). Local-dev defaults shown; rotate for real use.

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=3012

# ── Verify (your tenant + the Token Exchange app from the verify bootstrap) ──
VERIFY_TENANT_HOST=<your-tenant>.verify.ibm.com
VERIFY_TE_CLIENT_ID=

# VERIFY_TE_CLIENT_SECRET is normally fetched from Vault at
# secret/data/VERIFY_TE_CLIENT_SECRET on the first Token Exchange call
# (5-minute in-process cache). The bootstrap script in infra/verify/
# writes it there automatically when VAULT_ADDR + VAULT_TOKEN are set.
# Leave this line commented unless your stack has no Vault and you want
# the env-fallback path; in that case uncomment and paste the secret here.
#VERIFY_TE_CLIENT_SECRET=

# ── Vault (dev mode from infra/docker-compose.yml) ───────────────────────────
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=<paste the token printed by infra/vault/bootstrap-vault.sh>
VAULT_ROLE=healthcare-records

# ── Postgres admin (used ONLY for one health check at startup; the ─────────
#    actual reads run under the ephemeral role minted by Vault) ─────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=healthcare
POSTGRES_ADMIN_USER=vva_admin
POSTGRES_ADMIN_PASSWORD=vva_admin_local_dev_only

# ── MFA push + poll (used by the VIP step-up path in get_patient_record) ────
# Defaults match the canonical healthcare demo. Customer rarely needs to tune
# unless their tenant's userPresence push takes longer than 120s.
MFA_POLL_INTERVAL_MS=3000
MFA_POLL_TIMEOUT_MS=120000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
