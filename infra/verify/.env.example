# Copy to .env (gitignored) and fill in YOUR Verify tenant values.

# Your Verify tenant hostname, without the protocol.
# Example: acme-prod.verify.ibm.com
VERIFY_TENANT_HOST=<your-tenant>.verify.ibm.com

# Admin API client (see docs/verify-setup.md for how to create this manually).
# The RECOMMENDED path is to write these to Vault rather than to .env:
#   docker exec -e VAULT_TOKEN=vva-dev-root-token vva-vault \
#     vault kv put secret/VERIFY_ADMIN_CREDS \
#       client_id=<your-admin-client-id> client_secret=<your-admin-client-secret>
# bootstrap-verify.ts reads Vault first, env second. Leave these blank if you
# put them in Vault; uncomment and fill them in if your stack has no Vault.
#VERIFY_ADMIN_CLIENT_ID=
#VERIFY_ADMIN_CLIENT_SECRET=

# Names the bootstrap script will use when it creates new objects on your tenant.
# Pick anything unique; the defaults below are safe.
VERIFY_UI_APP_NAME=vva-healthcare-ui
VERIFY_TE_APP_NAME=vva-healthcare-token-exchange
VERIFY_POLICY_NAME=HealthcareStepUp
VERIFY_ATTRIBUTE_NAME=healthcareRarPresent

# Optional: where the bootstrap will land the TE client_secret so the MCP
# server can fetch it from Vault instead of reading it from its own .env.
# If you leave these blank, the bootstrap prints the secret for manual paste.
# Defaults below match the local dev stack from infra/docker-compose.yml +
# infra/vault/bootstrap-vault.sh.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=vva-dev-root-token
