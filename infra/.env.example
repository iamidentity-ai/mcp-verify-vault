# Copy to .env (gitignored). All values are local-dev defaults; rotate for real use.

# ── Verify ───────────────────────────────────────────────────────────────────
VERIFY_TENANT_HOST=<tenant>.verify.ibm.com
VERIFY_ADMIN_CLIENT_ID=
VERIFY_ADMIN_CLIENT_SECRET=                        

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_ADMIN_USER=vva_admin
POSTGRES_ADMIN_PASSWORD=vva_admin_local_dev_only
POSTGRES_DB=healthcare

# ── Vault (dev mode root token; never use in production) ─────────────────────
VAULT_ADDR=http://127.0.0.1:8200
VAULT_DEV_ROOT_TOKEN=vva-dev-root-token
