# Copy to .env (gitignored) before running uvicorn.

# Where the MCP server is listening. The local stack defaults to 3012.
HEALTHCARE_MCP_URL=http://127.0.0.1:3012/mcp

# Which LLM provider to use. See docs/llm-options.md for the full list.
# Default: anthropic (direct, requires ANTHROPIC_API_KEY).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929   # optional override

# Alternative providers (install the matching pyproject extra first):
# LLM_PROVIDER=bedrock        # pip install -e '.[bedrock]', then set AWS_REGION + credentials
# LLM_PROVIDER=openai         # pip install -e '.[openai]', then set OPENAI_API_KEY
# LLM_PROVIDER=gemini         # pip install -e '.[gemini]', then set GEMINI_API_KEY
